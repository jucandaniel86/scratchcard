{
  "name": "vue3-pixi",
  "type": "module",
  "version": "0.7.9",
  "description": "Vue createRenderer for PixiJS",
  "license": "MIT",
  "homepage": "https://github.com/hairyf/vue3-pixi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/vue3-pixi.git"
  },
  "bugs": {
    "url": "https://github.com/hairyf/vue3-pixi/issues"
  },
  "keywords": [
    "pixi.js",
    "vue"
  ],
  "main": "dist/index.cjs",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "dist",
    "global.d.ts"
  ],
  "dependencies": {
    "@antfu/utils": "^0.7.2",
    "@vueuse/core": "^10.1.2",
    "nanoid": "^4.0.2",
    "pixi.js": "^7.2.4",
    "vue-demi": "^0.14.1"
  },
  "devDependencies": {
    "@vue/runtime-core": "^3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "require": "./dist/compiler.cjs",
      "import": "./dist/compiler.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "require": "./dist/global.cjs",
      "import": "./dist/global.js"
    },
    "./*": "./*"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts"
}